Bundle-Name: Fennec OData Metadata
Bundle-Description: The ODataMetadataHandler (E1): attaches the resolved OData profile to every registered EPackage as the "odata" aspect of the Model Metadata Service

-library: \
	enableEMF

# E1 Foundation: the metadata model and service API live in emf.osgi (bundle
# org.eclipse.fennec.emf.osgi.metadata), consumed from Maven Central via the fennecEMF
# bnd library — see cnf/ext/fennec.bnd / central.mvn. This bundle owns NO Ecore of its
# own: the aspect content is the standalone profile model of org.eclipse.fennec.odata.csdl
# (ADR-0003).
-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.odata.csdl;version=project
