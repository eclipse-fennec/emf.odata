-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.odata.itests',\
	bnd.identity;id='org.eclipse.fennec.odata.runtime',\
	bnd.identity;id='org.eclipse.fennec.odata.persistence.inmemory',\
	bnd.identity;id='org.eclipse.fennec.odata.persistence.jpa',\
	bnd.identity;id='org.eclipse.fennec.odata.client',\
	bnd.identity;id='org.eclipse.fennec.odata.schema.api',\
	bnd.identity;id='org.eclipse.fennec.odata.operation.api',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='com.h2database',\
	bnd.identity;id='org.eclipse.fennec.odata.metadata',\
	bnd.identity;id='org.eclipse.fennec.model.metadata',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin'

-runbundles.test: \
	org.eclipse.fennec.odata.itests;version=snapshot,\
	org.eclipse.fennec.odata.schema.api;version=snapshot,\
	org.eclipse.fennec.odata.operation.api;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-21

-runproperties: \
	org.osgi.service.http.port=18893,\
	org.apache.felix.http.host=127.0.0.1

-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	com.h2database;version='[2.3.232,2.3.233)',\
	jakarta.persistence-api;version='[3.2.0,3.2.1)',\
	junit-jupiter-api;version='[5.14.2,5.14.3)',\
	junit-jupiter-params;version='[5.14.2,5.14.3)',\
	junit-platform-commons;version='[1.14.2,1.14.3)',\
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.daanse.jdbc.datasource.common;version='[0.0.1,0.0.2)',\
	org.eclipse.daanse.jdbc.datasource.h2;version='[0.0.1,0.0.2)',\
