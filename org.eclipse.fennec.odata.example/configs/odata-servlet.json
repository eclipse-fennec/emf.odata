{
	":configurator:resource-version": 1,
	":configurator:symbolicname": "org.eclipse.fennec.odata.example",
	":configurator:version": "0.0.0",

	"org.eclipse.fennec.odata.servlet": {

		// --- DoS / request limits (secure defaults shown explicitly) ---
		// Each cap: a POSITIVE value bounds the request; <= 0 DISABLES the cap (an
		// unbounded-amplification foot-gun — never do this on an exposed service).
		"odata.max.top": 1000,
		"odata.max.expression.length": 4096,
		"odata.max.nesting.depth": 64,
		"odata.max.body.size": 1048576,
		"odata.max.batch.operations": 100,

		// --- async ($respond-async) bounds (secure defaults) ---
		"odata.max.async.inflight": 16,
		"odata.max.async.monitors": 100,

		// --- CORS ---
		// EXAMPLE-ONLY: "*" lets a browser explorer (e.g. XOData) call the service from any
		// origin. The production default is "" (CORS OFF). Do NOT ship "*" — restrict to an
		// explicit space-separated origin allowlist for anything reachable off localhost.
		"odata.cors.origin": "*"

		// --- service root & published model (defaults shown; see docs/manual/04-configuration.md) ---
		// This singleton configuration keeps the ONE default root at /odata/* describing every
		// registered EPackage. A factory configuration ("org.eclipse.fennec.odata.servlet~shop")
		// mounts an additional/alternative root instead — and replaces the default one:
		//   "osgi.http.whiteboard.servlet.pattern": "/shop/*",
		//   "osgi.http.whiteboard.target": "(id=shopHttp)",           // one named HTTP runtime
		//   "odata.model.packages": ["http://example.org/webshop"],  // schemas of this root
		//   "odata.model.entitysets": ["Products=http://example.org/webshop#Product", "Category"]
		// The request-limits filter follows suit under "org.eclipse.fennec.odata.request.filter~shop"
		// with "osgi.http.whiteboard.filter.pattern" and the same target.
	}
}
