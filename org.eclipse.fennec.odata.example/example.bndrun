# SBOM for `./gradlew sbom`: the exporter is included only once it has been fetched (see
# cnf/sbom/plugin.bnd); resolve, the build and the tests ignore both lines.
-include: ${if;${isfile;${workspace}/cnf/cache/sbom-exporter/org.gecko.bnd.sbom.jar};${workspace}/cnf/sbom/plugin.bnd}
-sbom: level=medium, format=cyclonedx

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.odata.example',\
	bnd.identity;id='org.eclipse.fennec.odata.runtime',\
	bnd.identity;id='org.eclipse.fennec.odata.persistence.inmemory',\
	bnd.identity;id='org.eclipse.fennec.odata.persistence.inmemory.write',\
	bnd.identity;id='org.eclipse.fennec.odata.metadata',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.metadata',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command'

-runfw: org.apache.felix.framework

-runee: JavaSE-21

# spifly.dynamic.framework.extension 1.3.x embeds an ASM that cannot read the class files of
# a newer JDK ("Unsupported class file major version 69" -> "Weaving hook failed", Jetty never
# starts on Java 25). Keep the resolver on the dynamic.bundle variant.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runproperties: \
	org.osgi.service.http.port=8080
-runbundles: \
	org.antlr.antlr4-runtime;version='[4.13.2,4.13.3)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)',\
	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.m2x.ocl.model;version='[0.1.1,0.1.2)',\
	org.eclipse.fennec.odata.codec.json;version=snapshot,\
	org.eclipse.fennec.odata.csdl;version=snapshot,\
	org.eclipse.fennec.odata.example;version=snapshot,\
	org.eclipse.fennec.odata.metadata;version=snapshot,\
	org.eclipse.fennec.odata.persistence.api;version=snapshot,\
	org.eclipse.fennec.odata.persistence.inmemory;version=snapshot,\
	org.eclipse.fennec.odata.persistence.inmemory.write;version=snapshot,\
	org.eclipse.fennec.odata.query;version=snapshot,\
	org.eclipse.fennec.odata.runtime;version=snapshot,\
	org.odata.csdl.model;version='[4.0.1,4.0.2)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.emf.osgi.metadata;version='[1.1.0,1.1.1)',\
	org.eclipse.fennec.odata.ocl.evaluator;version=snapshot,\
	org.eclipse.fennec.odata.operation.api;version=snapshot,\
	org.eclipse.fennec.persistence;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.persistence.capabilities;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.odata.wire.api;version=snapshot,\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.23.0,2.23.1)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.8,1.3.9)',\
	org.apache.felix.cm.json;version='[2.0.8,2.0.9)',\
	org.apache.felix.configadmin;version='[1.10.0,1.10.1)',\
	org.apache.felix.scr;version='[2.3.0,2.3.1)',\
	org.eclipse.emf.common;version='[2.46.0,2.46.1)',\
	org.eclipse.emf.ecore;version='[2.43.0,2.43.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.41.0,2.41.1)',\
	org.eclipse.parsson.jakarta.json;version='[1.1.9,1.1.10)',\
	org.objectweb.asm;version='[9.11.1,9.11.2)',\
	org.objectweb.asm.commons;version='[9.11.1,9.11.2)',\
	org.objectweb.asm.tree;version='[9.11.1,9.11.2)',\
	org.objectweb.asm.tree.analysis;version='[9.11.1,9.11.2)',\
	org.objectweb.asm.util;version='[9.11.1,9.11.2)',\
	slf4j.api;version='[2.0.20,2.0.21)',\
	slf4j.simple;version='[2.0.20,2.0.21)',\
	tools.jackson.core.jackson-core;version='[3.3.0,3.3.1)',\
	tools.jackson.core.jackson-databind;version='[3.3.0,3.3.1)',\
	org.apache.felix.http.jetty12;version='[1.0.36,1.0.37)'