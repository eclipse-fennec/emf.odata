Bundle-Name: Fennec OData JSON Codec
Bundle-Description: OData-JSON data codec profile (E3) — serializes/deserializes EObject instances in the OData JSON format (@odata.type/@odata.id conventions, Edm.* value formats) as a Fennec codec profile, analogous to the GeoJSON profile
Bundle-Version: 1.0.0

-library: enableEMF

# codec framework + metadata service are external binaries (fennecCodec/fennecEMFMetadata
# libraries -> version=latest); the OData profile source (resolver + profile model) comes
# from this workspace (version=project).
-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.model.metadata.api;version=latest,\
	org.eclipse.fennec.model.metadata;version=latest,\
	org.eclipse.fennec.odata.metadata;version=project,\
	org.eclipse.fennec.odata.csdl;version=project,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest
