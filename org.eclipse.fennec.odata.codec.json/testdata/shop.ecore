<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="shop" nsURI="http://example.org/shop" nsPrefix="shop">
  <eAnnotations source="https://eclipse.org/fennec/odata">
    <details key="OData.Namespace" value="My.Shop"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1" iD="true"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBigDecimal"/>
    <!-- EDate forced to date-only via @OData.Type -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="releaseDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="https://eclipse.org/fennec/odata">
        <details key="OData.Type" value="Edm.Date"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- EDate defaults to Edm.DateTimeOffset -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modified"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- EByteArray -> Edm.Binary (base64url) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="photo"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EByteArray"/>
    <!-- string attribute carrying a guid -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="guid"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="https://eclipse.org/fennec/odata">
        <details key="OData.Type" value="Edm.Guid"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- ELong -> Edm.Int64: precision on the wire (values above 2^53) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serial"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <!-- EDate -> Edm.TimeOfDay -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="openingTime"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="https://eclipse.org/fennec/odata">
        <details key="OData.Type" value="Edm.TimeOfDay"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- string carrying an ISO-8601 duration -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="warranty"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="https://eclipse.org/fennec/odata">
        <details key="OData.Type" value="Edm.Duration"/>
      </eAnnotations>
    </eStructuralFeatures>
    <!-- enum value: must serialize as the member NAME, not the ordinal -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color" eType="#//Color"/>
    <!-- collection of a primitive (multi-valued) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Color">
    <eLiterals name="Red"/>
    <eLiterals name="Green" value="1"/>
    <eLiterals name="Blue" value="2"/>
  </eClassifiers>
</ecore:EPackage>
