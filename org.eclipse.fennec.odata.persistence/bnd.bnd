Bundle-Name: Fennec OData Command Backend
Bundle-Description: Backend-neutral WriteService over the Fennec Persistence CommandResource SPI — POST/PATCH/PUT/DELETE become Insert/Update/DeleteCommand with Expression-IR key selectors and ChangeSet templates, served identically by the JPA and Mongo backends; constructs the command engine cannot express are refused with honest 501s

-buildpath: \
	org.eclipse.fennec.odata.persistence.api;version=project,\
	org.eclipse.fennec.odata.query;version=project,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.command.model;version=latest,\
	org.eclipse.fennec.expression.model;version=latest,\
	org.eclipse.fennec.expression.ocl;version=latest,\
	org.eclipse.fennec.query.model;version=latest,\
	org.eclipse.fennec.stream.model;version=latest,\
	org.eclipse.fennec.persistence.query;version=latest,\
	org.eclipse.fennec.persistence.capabilities;version=latest,\
	org.eclipse.fennec.persistence;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.emf.common;version=latest

# The Mongo tests drive the SAME CommandPersistenceService against a real MongoDB (skipped
# without docker/podman or -Dmongo.uri) — wiring mirrors the upstream persistence TCK.
# The differential suite compares the IR engines against the neutral OCL reference evaluator.
-testpath: \
	assertj-core;version=latest,\
	org.eclipse.fennec.odata.ocl.evaluator;version=project,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.persistence.mongo;version=latest,\
	org.eclipse.fennec.persistence.pushstreams;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.bson;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.mongodb.bson;version=latest,\
	org.mongodb.driver-core;version=latest,\
	org.mongodb.driver-sync;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest
