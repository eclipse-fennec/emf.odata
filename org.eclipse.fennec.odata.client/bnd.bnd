Bundle-Name: Fennec OData Client
Bundle-Description: OData v4 client foundation (E8): reads a remote service's $metadata into Ecore (E2 read path), builds entity-set requests through a fluent URL builder and decodes OData-JSON responses into EObjects via the codec profile (E3) — java.net.http transport, no Olingo (ADR-0005)

-library: enableEMF

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.odata.schema.api;version=project,\
	org.eclipse.fennec.odata.csdl;version=project,\
	org.eclipse.fennec.odata.codec.json;version=project,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.model.metadata.api;version=latest,\
	org.eclipse.fennec.model.metadata;version=latest,\
	org.odata.csdl.model;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest
