Bundle-Name: Fennec OData In-Memory Query Backend
Bundle-Description: In-memory QueryService (req §3.5, mandatory reference backend for tests): evaluates the OCL predicate IR directly against EObjects supplied by EntityRepository services; includes a file-based repository (XMI resources from a configured directory)
Bundle-Version: 1.0.0

-library: enableEMF

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.odata.query;version=project,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.odata.persistence.api;version=project,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest
