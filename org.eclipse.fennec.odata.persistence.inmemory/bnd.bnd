Bundle-Name: Fennec OData In-Memory Read Backend
Bundle-Description: The in-memory READ side (req §3.5, mandatory reference backend for tests): the QueryService that evaluates the OCL predicate IR directly against the EObjects any EntityRepository supplies, the $apply executor, and FileEntityRepository — an EntityRepository that loads XMI/XML resources from ONE configured directory into memory at activation. Everything here is read-only: the writable store lives in org.eclipse.fennec.odata.persistence.inmemory.write, so a read-only deployment can decline it without losing the query engine.

-library: enableEMF

-buildpath: \
	org.osgi.service.condition;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.odata.query;version=project,\
	org.eclipse.fennec.odata.wire.api;version=project,\
	org.eclipse.fennec.odata.ocl.evaluator;version=project,\
	org.antlr.antlr4-runtime;version=latest,\
	org.eclipse.fennec.odata.persistence.api;version=project,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest

# EntityKeys (persistence.api) resolves the identity through CompositeIds — the plain JUnit tests
# need the helper on the classpath, at runtime the OSGi wiring of persistence.api provides it.
-testpath: \
	org.eclipse.fennec.persistence;version=latest
